{
  "name": "pi-acp",
  "version": "0.1.0",
  "private": true,
  "description": "ACP v1 adapter for Pi Agent, built on Pi's RPC mode",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "bun run generate && bun src/index.ts",
    "generate": "node scripts/generate-mcp-extension.mjs",
    "build": "bun run generate && node build.mjs",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun run generate && vitest run",
    "test:e2e": "bun run build && RUN_PI_E2E=true vitest run --no-file-parallelism src/__tests__/e2e",
    "release": "bash scripts/release.sh",
    "package": "bun run build && cp dist/index.js dist/pi-acp && chmod +x dist/pi-acp && rm -f dist/pi-acp.zip && zip -j dist/pi-acp.zip dist/pi-acp LICENSE NOTICE"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
